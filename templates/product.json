    "knr_ritual": {
      "type": "knr-skin-ritual",
      "settings": {
        "tag": "Your Ritual",
        "heading": "Embrace your natural glow",
        "description": "<p>Indulge in a daily skincare ritual that combines the power of nature with advanced dermatological science. Our formulations are designed to nourish, protect, and rejuvenate your skin, delivering visible results and a luminous, healthy complexion that radiates from within.</p>"
      }
