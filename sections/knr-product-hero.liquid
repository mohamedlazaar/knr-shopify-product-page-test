{%- comment -%}
  sections/product-details.liquid
  Product details section — big hero + 2-col gallery on the left, sticky white info card on the right.
  Use it in templates/product.json (or product.liquid).
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'pd-form-' | append: section.id
  assign delivery_days = section.settings.delivery_days
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign delivery_ts = delivery_days | times: 86400 | plus: now_ts
  assign fr_days = 'Dimanche,Lundi,Mardi,Mercredi,Jeudi,Vendredi,Samedi' | split: ','
  assign fr_months = 'janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre' | split: ','
  assign d_idx = delivery_ts | date: '%w' | plus: 0
  assign m_idx = delivery_ts | date: '%-m' | plus: 0 | minus: 1
  assign d_num = delivery_ts | date: '%-d'
  assign delivery_date = fr_days[d_idx] | append: ' ' | append: d_num | append: ' ' | append: fr_months[m_idx]
-%}

{{ section.settings.font | font_face: font_display: 'swap' }}

{% style %}
  #pd-{{ section.id }} {
    --pd-text: {{ section.settings.text_color }};
    --pd-muted: {{ section.settings.muted_color }};
    --pd-line: {{ section.settings.line_color }};
    --pd-card: {{ section.settings.card_color }};
    --pd-btn-bg: {{ section.settings.button_bg }};
    --pd-btn-text: {{ section.settings.button_text }};
    --pd-page: {{ section.settings.page_color }};
    --pd-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --pd-gap: 9px;
  }
  #pd-{{ section.id }} { background: var(--pd-page); color: var(--pd-text); font-family: var(--pd-font); font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  #pd-{{ section.id }} *, #pd-{{ section.id }} *::before, #pd-{{ section.id }} *::after { box-sizing: border-box; }
  #pd-{{ section.id }} img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #pd-{{ section.id }} button { font: inherit; color: inherit; cursor: pointer; }
  #pd-{{ section.id }} a { color: inherit; text-decoration: none; }
  #pd-{{ section.id }} :focus-visible { outline: 2px solid var(--pd-text); outline-offset: 3px; }

  /* ---------- Layout ---------- */
  #pd-{{ section.id }} .pd { display: grid; grid-template-columns: minmax(0, 65.6%) minmax(0, 1fr); background: var(--pd-card); }
  #pd-{{ section.id }} .pd__media { display: contents; }
  #pd-{{ section.id }} .pd__hero { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 1526 / 730; position: relative; background: var(--pd-page); overflow: hidden; }
  #pd-{{ section.id }} .pd__grid { grid-column: 1; grid-row: 2; display: grid; grid-template-columns: 1fr 1fr; gap: var(--pd-gap); margin-top: var(--pd-gap); align-content: start; }
  #pd-{{ section.id }} .pd__tile { position: relative; aspect-ratio: 495 / 647; overflow: hidden; background: var(--pd-page); }
  #pd-{{ section.id }} .pd__zoom { position: absolute; right: 16px; bottom: 16px; width: 28px; height: 28px; display: grid; place-items: center; background: none; border: 0; padding: 0; color: #fff; }
  #pd-{{ section.id }} .pd__zoom svg { width: 20px; height: 20px; }
  #pd-{{ section.id }} .pd__dots { display: none; }

  #pd-{{ section.id }} .pd__info { grid-column: 2; grid-row: 1 / span 2; padding: 59px 41px 0 0; position: relative; z-index: 2; pointer-events: none; }
  #pd-{{ section.id }} .pd__card { pointer-events: auto; position: sticky; top: 20px; background: var(--pd-card); padding: 42px 42px 48px; }

  /* ---------- Blocks ---------- */
  #pd-{{ section.id }} .pd-breadcrumb { font-size: 11px; color: var(--pd-muted); margin: 0 0 40px; }
  #pd-{{ section.id }} .pd-breadcrumb a:hover { text-decoration: underline; }
  #pd-{{ section.id }} .pd-badges { display: flex; flex-wrap: wrap; gap: 4px; margin: 0 0 32px; padding: 0; list-style: none; }
  #pd-{{ section.id }} .pd-badges li { border: 1px solid var(--pd-text); border-radius: 2px; padding: 2px 4px; font-size: 13px; line-height: 1.4; text-transform: uppercase; }
  #pd-{{ section.id }} .pd-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin: 0 0 30px; }
  #pd-{{ section.id }} .pd-title { margin: 0; font-size: 26px; line-height: 1.3; font-weight: 400; text-transform: uppercase; }
  #pd-{{ section.id }} .pd-rating { flex: none; text-align: right; font-size: 11px; color: var(--pd-muted); padding-top: 2px; line-height: 1.6; }
  #pd-{{ section.id }} .pd-stars { position: relative; display: inline-block; font-size: 10px; letter-spacing: 2px; line-height: 1; }
  #pd-{{ section.id }} .pd-stars__bg { opacity: .35; }
  #pd-{{ section.id }} .pd-stars__fg { position: absolute; inset: 0 auto 0 0; overflow: hidden; white-space: nowrap; }
  #pd-{{ section.id }} .pd-rating__count { display: block; opacity: .8; margin-top: 4px; }
  #pd-{{ section.id }} .pd-scores { margin: 0 0 22px; }
  #pd-{{ section.id }} .pd-scores strong { font-weight: 600; }
  #pd-{{ section.id }} .pd-scores span { margin: 0 4px; }
  #pd-{{ section.id }} .pd-intro { margin: 0 0 46px; line-height: 1.75; }
  #pd-{{ section.id }} .pd-intro p { margin: 0; }

  #pd-{{ section.id }} .pd-option { border: 0; margin: 0 0 40px; padding: 0; min-width: 0; }
  #pd-{{ section.id }} .pd-option legend { padding: 0; margin: 0 0 24px; }
  #pd-{{ section.id }} .pd-option__values { display: flex; flex-wrap: wrap; gap: 6px 10px; }
  #pd-{{ section.id }} .pd-option input { position: absolute; opacity: 0; pointer-events: none; }
  #pd-{{ section.id }} .pd-option label { cursor: pointer; padding-bottom: 2px; border-bottom: 1px solid transparent; }
  #pd-{{ section.id }} .pd-option input:checked + label { border-bottom-color: var(--pd-text); }
  #pd-{{ section.id }} .pd-option input:focus-visible + label { outline: 2px solid var(--pd-text); outline-offset: 3px; }
  #pd-{{ section.id }} .pd-option input:disabled + label { opacity: .4; text-decoration: line-through; }

  #pd-{{ section.id }} .pd-price { margin: 0 0 34px; }
  #pd-{{ section.id }} .pd-price__row { display: flex; align-items: baseline; gap: 6px; }
  #pd-{{ section.id }} .pd-price__now { font-size: 26px; line-height: 1.2; }
  #pd-{{ section.id }} .pd-price__was { font-size: 11px; color: var(--pd-muted); text-decoration: line-through; }
  #pd-{{ section.id }} .pd-price__unit { margin: 8px 0 0; font-size: 12px; color: var(--pd-muted); }

  #pd-{{ section.id }} .pd-buy { margin: 0 0 26px; }
  #pd-{{ section.id }} .pd-atc { width: 100; height: 51px; background: var(--pd-btn-bg); color: var(--pd-btn-text) !important; border: 1px solid var(--pd-btn-bg); border-radius: 0; font-size: 14px; transition: opacity .2s; }
  #pd-{{ section.id }} .pd-atc:hover { opacity: .85; }
  #pd-{{ section.id }} .pd-atc:disabled { opacity: .45; cursor: not-allowed; }
  #pd-{{ section.id }} .pd-delivery { margin: 16px 0 0; text-align: center; font-size: 12px; }

  #pd-{{ section.id }} .pd-acc { border-top: 1px solid var(--pd-line); }
  #pd-{{ section.id }} .pd-acc summary { list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 24px 0; cursor: pointer; }
  #pd-{{ section.id }} .pd-acc summary::-webkit-details-marker { display: none; }
  #pd-{{ section.id }} .pd-acc svg { width: 12px; height: 12px; transition: transform .25s; flex: none; }
  #pd-{{ section.id }} .pd-acc[open] svg { transform: rotate(180deg); }
  #pd-{{ section.id }} .pd-acc__body { padding: 0 0 24px; line-height: 1.75; }
  #pd-{{ section.id }} .pd-acc__body > :first-child { margin-top: 0; }
  #pd-{{ section.id }} .pd-acc__body > :last-child { margin-bottom: 0; }
  #pd-{{ section.id }} .pd-acc[open] summary { padding-bottom: 18px; }

  #pd-{{ section.id }} .pd-ritual { margin-top: 44px; }
  #pd-{{ section.id }} .pd-ritual__head { display: flex; justify-content: space-between; align-items: center; margin: 0 0 20px; text-transform: uppercase; }
  #pd-{{ section.id }} .pd-ritual__next { background: none; border: 0; padding: 0; width: 20px; height: 20px; display: grid; place-items: center; }
  #pd-{{ section.id }} .pd-ritual__next svg { width: 12px; height: 12px; }
  #pd-{{ section.id }} .pd-ritual__track { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-right: -42px; padding-right: 42px; }
  #pd-{{ section.id }} .pd-ritual__track::-webkit-scrollbar { display: none; }
  #pd-{{ section.id }} .pd-ritual__item { flex: 0 0 42.4%; scroll-snap-align: start; min-width: 0; }
  #pd-{{ section.id }} .pd-ritual__img { position: relative; aspect-ratio: 169 / 221; background: var(--pd-page); overflow: hidden; }
  #pd-{{ section.id }} .pd-ritual__add { position: absolute; left: 10px; bottom: 10px; width: 16px; height: 16px; display: grid; place-items: center; background: #fff; border: 0; padding: 0; }
  #pd-{{ section.id }} .pd-ritual__add svg { width: 8px; height: 8px; }
  #pd-{{ section.id }} .pd-ritual__meta { display: flex; justify-content: space-between; gap: 8px; margin-top: 12px; font-size: 12px; }
  #pd-{{ section.id }} .pd-ritual__meta span:last-child { white-space: nowrap; }

  #pd-{{ section.id }} .pd-lightbox { border: 0; padding: 0; background: transparent; max-width: 92vw; max-height: 92vh; }
  #pd-{{ section.id }} .pd-lightbox::backdrop { background: rgba(0,0,0,.75); }
  #pd-{{ section.id }} .pd-lightbox img { width: auto; height: auto; max-width: 92vw; max-height: 92vh; object-fit: contain; }

  /* ---------- Mobile ... */
{% endstyle %}

<section id="pd-{{ section.id }}" data-section-id="{{ section.id }}" data-after-add="{{ section.settings.after_add }}" data-unavailable="{{ section.settings.sold_out_label | escape }}" data-added="{{ section.settings.added_label | escape }}">
  <div class="pd">
    ... (rest of the file omitted for brevity)
</section>

<script>
  // JavaScript omitted for brevity
</script>

{% schema %}

{
  "name": "Product details",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted color",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "page_color",
      "label": "Page background",
      "default": "#f9f9f9"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "Helvetica"
    },
    {
      "type": "range",
      "id": "delivery_days",
      "label": "Delivery days offset",
      "min": 0,
      "max": 30,
      "default": 2
    },
    {
      "type": "text",
      "id": "after_add",
      "label": "After add label",
      "default": "Added to cart"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added label",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    }
  ],
  "presets": [
    {
      "name": "Product details"
    }
  ]
}
{% endschema %}

