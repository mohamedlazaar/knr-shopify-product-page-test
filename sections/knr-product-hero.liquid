{{ 'knr-product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-animations.js' | asset_url }}" defer></script>

{% comment %}
  Section 1: Product Hero
  Two-column layout – gallery left, product info right
  Mobile: single column, full-width buttons
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<section class="knr-section knr-product-hero" data-section-id="{{ section.id }}">
  <div class="knr-container">
    <div class="knr-product-hero__grid">

      {%- comment -%} ── Gallery Column ── {%- endcomment -%}
      <div class="knr-product-hero__gallery">
        <div class="knr-product-hero__gallery-main">
          {%- if featured_image != blank -%}
            {{ featured_image | image_url: width: 900 | image_tag:
              loading: 'eager',
              alt: product.title,
              id: 'knr-main-image',
              sizes: '(min-width: 750px) 50vw, 100vw'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="knr-product-hero__gallery-thumbs">
            {%- for image in product.images limit: 4 -%}
              <div class="knr-product-hero__thumb{% if forloop.first %} active{% endif %}" data-image-url="{{ image | image_url: width: 900 }}" data-index="{{ forloop.index0 }}">
                {{ image | image_url: width: 200 | image_tag:
                  loading: 'lazy',
                  alt: product.title
                }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Product Info Column ── {%- endcomment -%}
      <div class="knr-product-hero__info">

        {%- if section.settings.show_brand -%}
          <p class="knr-product-hero__brand">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="knr-product-hero__title">{{ product.title }}</h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="knr-product-hero__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="knr-product-hero__price-row">
          <span class="knr-product-hero__price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="knr-product-hero__price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_rating -%}
          <div class="knr-product-hero__rating">
            <span class="knr-product-hero__stars">★★★★★</span>
            <span class="knr-product-hero__review-count">{{ section.settings.review_count }}</span>
          </div>
        {%- endif -%}

        <div class="knr-product-hero__divider"></div>

        {%- comment -%} Variant Picker {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div>
              <p class="knr-product-hero__size-label">{{ option.name }}</p>
              <div class="knr-product-hero__sizes">
                {%- for value in option.values -%}
                  <button type="button" class="knr-product-hero__size-btn{% if option.selected_value == value %} active{% endif %}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Quantity {%- endcomment -%}
        <div>
          <p class="knr-product-hero__size-label">{{ 'products.product.quantity.label' | t | default: 'Quantity' }}</p>
          <div class="knr-product-hero__quantity">
            <button type="button" class="knr-product-hero__qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
            <span class="knr-product-hero__qty-val" id="knr-qty-value">1</span>
            <button type="button" class="knr-product-hero__qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
          </div>
        </div>

        {%- comment -%} Add to Cart {%- endcomment -%}
        <product-form class="knr-product-hero__form">
          {%- form 'product', product, id: 'knr-product-form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1" id="knr-qty-input">

            <div class="knr-product-hero__actions">
              <button
                type="submit"
                name="add"
                class="knr-btn knr-btn--primary knr-btn--full"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                {%- endif -%}
              </button>

              {%- if section.settings.show_buy_now -%}
                <button type="button" class="knr-btn knr-btn--outline knr-btn--full">
                  {{ section.settings.buy_now_text | default: 'Buy Now' }}
                </button>
              {%- endif -%}
            </div>
          {%- endform -%}
        </product-form>

        {%- comment -%} Meta info (shipping, returns) {%- endcomment -%}
        {%- if section.settings.show_meta -%}
          <div class="knr-product-hero__meta">
            {%- for block in section.blocks -%}
              {%- if block.type == 'meta_item' -%}
                <div class="knr-product-hero__meta-item" {{ block.shopify_attributes }}>
                  <svg class="knr-product-hero__meta-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
                    {%- if block.settings.icon == 'shipping' -%}
                      <path d="M1 4h9v7H1z"/><path d="M10 6.5h3l2 2.5v2h-5z"/><circle cx="4" cy="12" r="1.5"/><circle cx="12.5" cy="12" r="1.5"/>
                    {%- elsif block.settings.icon == 'returns' -%}
                      <path d="M4 7l-3 3 3 3"/><path d="M1 10h10a4 4 0 000-8H8"/>
                    {%- elsif block.settings.icon == 'secure' -%}
                      <rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5 7V5a3 3 0 016 0v2"/>
                    {%- else -%}
                      <circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/>
                    {%- endif -%}
                  </svg>
                  <span>{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Description {%- endcomment -%}
        {%- if product.description != blank and section.settings.show_description -%}
          <div class="knr-product-hero__divider"></div>
          <div class="knr-body">
            {{ product.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* Thumbnail gallery */
    const thumbs = document.querySelectorAll('.knr-product-hero__thumb');
    const mainImg = document.getElementById('knr-main-image');
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        thumbs.forEach(function (t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        if (mainImg && thumb.dataset.imageUrl) {
          mainImg.src = thumb.dataset.imageUrl;
          mainImg.srcset = '';
        }
      });
    });

    /* Quantity stepper */
    const qtyVal = document.getElementById('knr-qty-value');
    const qtyInput = document.getElementById('knr-qty-input');
    document.querySelectorAll('.knr-product-hero__qty-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        let val = parseInt(qtyVal.textContent) || 1;
        if (btn.dataset.action === 'increase') val++;
        if (btn.dataset.action === 'decrease' && val > 1) val--;
        qtyVal.textContent = val;
        if (qtyInput) qtyInput.value = val;
      });
    });
  });
</script>

{% schema %}
{
  "name": "KNR Product Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Product subtitle",
      "default": "Hydrating face serum with hyaluronic acid & botanical extracts"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "label": "Show vendor / brand",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating stars",
      "default": true
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count text",
      "default": "(128 reviews)"
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show Buy Now button",
      "default": true
    },
    {
      "type": "text",
      "id": "buy_now_text",
      "label": "Buy Now button text",
      "default": "Buy Now"
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show meta info (shipping, returns)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "meta_item",
      "name": "Meta info item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders $50+"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Product Hero",
      "category": "Product",
      "blocks": [
        {
          "type": "meta_item",
          "settings": {
            "icon": "shipping",
            "text": "Free shipping on orders $50+"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "icon": "returns",
            "text": "30-day easy returns"
          }
        },
        {
          "type": "meta_item",
          "settings": {
            "icon": "secure",
            "text": "Secure checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
