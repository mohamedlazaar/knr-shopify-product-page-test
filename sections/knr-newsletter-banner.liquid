{%- comment -%}
  sections/newsletter-banner.liquid
  Image on the left, large statement + email signup on the right.
  Mobile: image on top, statement, stacked email field and button.
  Uses Shopify's native customer form (tag: newsletter).
{%- endcomment -%}


{% style %}
  #nl-{{ section.id }} {
    --nl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --nl-bg: {{ section.settings.bg_color }};
    --nl-text: {{ section.settings.text_color }};
    --nl-field-border: {{ section.settings.field_border }};
    --nl-field-bg: {{ section.settings.field_bg }};
    --nl-btn-bg: {{ section.settings.button_bg }};
    --nl-btn-text: {{ section.settings.button_text }};
    background: var(--nl-bg);
    color: var(--nl-text);
    font-family: var(--nl-font);
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
  }
  #nl-{{ section.id }} * { box-sizing: border-box; }
  #nl-{{ section.id }} .nl { display: grid; grid-template-columns: minmax(0, 1.064fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  #nl-{{ section.id }} .nl__media { aspect-ratio: {{ section.settings.image_ratio }}; background: #e8e5dc; overflow: hidden; }
  #nl-{{ section.id }} .nl__media img, #nl-{{ section.id }} .nl__media svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  #nl-{{ section.id }} .nl__body { max-width: 600px; padding-right: 30px; }
  #nl-{{ section.id }} .nl__title { margin: 0 0 44px; max-width: 575px; font-size: 36px; font-weight: 400; line-height: 1.22; letter-spacing: -0.01em; }
  #nl-{{ section.id }} .nl__title--m { display: none; }
  #nl-{{ section.id }} .nl__form { display: flex; align-items: stretch; }
  #nl-{{ section.id }} .nl__input { flex: 1 1 auto; min-width: 0; height: 47px; padding: 0 22px; background: var(--nl-field-bg); border: 1px solid var(--nl-field-border); border-right: 0; border-radius: 2px 0 0 2px; font: inherit; font-size: 12px; color: var(--nl-text); }
  #nl-{{ section.id }} .nl__input::placeholder { color: var(--nl-text); opacity: 1; }
  #nl-{{ section.id }} .nl__input:focus-visible { outline: 2px solid var(--nl-text); outline-offset: -2px; }
  #nl-{{ section.id }} .nl__btn { flex: 0 0 160px; height: 47px; background: var(--nl-btn-bg); color: var(--nl-btn-text); border: 1px solid var(--nl-btn-bg); border-radius: 0 2px 2px 0; font: inherit; font-size: 12px; cursor: pointer; transition: opacity .2s; }
  #nl-{{ section.id }} .nl__btn:hover { opacity: .85; }
  #nl-{{ section.id }} .nl__note { margin: 22px 0 0; font-size: 10.5px; line-height: 1.5; }
  #nl-{{ section.id }} .nl__msg { margin: 14px 0 0; font-size: 12px; }

  @media (max-width: 989px) {
    #nl-{{ section.id }} { padding: {{ section.settings.padding_top_mobile }}px 24px {{ section.settings.padding_bottom_mobile }}px; }
    #nl-{{ section.id }} .nl { display: block; }
    #nl-{{ section.id }} .nl__body { max-width: none; padding: 30px 0 0; }
    #nl-{{ section.id }} .nl__title { font-size: 29px; line-height: 1.4; letter-spacing: -0.01em; margin-bottom: 44px; max-width: none; }
    {%- if section.settings.heading_mobile != blank -%}
    #nl-{{ section.id }} .nl__title--d { display: none; }
    #nl-{{ section.id }} .nl__title--m { display: block; }
    {%- endif -%}
    #nl-{{ section.id }} .nl__form { flex-direction: column; gap: 17px; }
    #nl-{{ section.id }} .nl__input { flex: none; width: 100%; height: 47px; border-right: 1px solid var(--nl-field-border); border-radius: 2px; padding: 0 24px; font-size: 13px; }
    #nl-{{ section.id }} .nl__btn { flex: none; width: 100%; height: 47px; border-radius: 2px; font-size: 14px; }
    #nl-{{ section.id }} .nl__note { margin-top: 22px; font-size: 11px; }
  }
{% endstyle %}

<section id="nl-{{ section.id }}">
  <div class="nl">
    <div class="nl__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading | strip_html | escape }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="nl__body">
      {%- if section.settings.heading != blank -%}
        <h2 class="nl__title nl__title--d">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.heading_mobile != blank -%}
        <h2 class="nl__title nl__title--m">{{ section.settings.heading_mobile }}</h2>
      {%- endif -%}

      {%- form 'customer', id: 'nl-form', class: 'nl__form-wrap' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nl__form">
          <label for="nl-email-{{ section.id }}" class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">{{ section.settings.placeholder }}</label>
          <input id="nl-email-{{ section.id }}" class="nl__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" required value="{{ form.email }}"{% if form.errors %} aria-invalid="true"{% endif %}>
          <button type="submit" class="nl__btn">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="nl__msg" role="status">{{ section.settings.success_message }}</p>
        {%- elsif form.errors -%}
          <p class="nl__msg" role="alert">{{ section.settings.error_message }}</p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}<p class="nl__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "5 / 4", "label": "5:4" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "3:2" }
      ],
      "default": "5 / 4"
    },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "L'alliance de la science botanique et du luxe naturel pour une peau visiblement rajeunie en 4 semaines." },
    { "type": "textarea", "id": "heading_mobile", "label": "Heading (mobile, optional)", "info": "Leave empty to use the same heading on mobile.", "default": "Sérum précieux régénérant — l'alliance de la science botanique et du luxe naturel pour une peau visiblement rajeunie en 4 semaines." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "E-mail" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "S'inscrire" },
    { "type": "text", "id": "note", "label": "Small text", "default": "Formule brevetée, testée dermatologiquement, 97 % d'ingrédients d'origine naturelle." },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Merci ! Vous êtes bien inscrit(e)." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Adresse e-mail invalide. Veuillez réessayer." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "field_bg", "label": "Field background", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Field border", "default": "#ebe6d8" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 68 }
  ],
  "presets": [
    { "name": "Newsletter banner" }
  ]
}
{% endschema %}
