{% comment %}
  Section 5: FAQ Accordion
  Collapsible question/answer pairs with smooth transitions.
  Centered heading with serif font, "View all" button at bottom.
{% endcomment %}

<section class="knr-section knr-faq" data-section-id="{{ section.id }}">
  <div class="knr-container">

    <div class="knr-faq__header knr-animate">
      {%- if section.settings.tag != blank -%}
        <p class="knr-label" style="margin-bottom: 8px;">{{ section.settings.tag }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="knr-faq__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="knr-faq__list knr-animate knr-animate-delay-1">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <div class="knr-faq__item" {{ block.shopify_attributes }}>
            <button class="knr-faq__question" aria-expanded="false" aria-controls="knr-faq-answer-{{ section.id }}-{{ forloop.index }}">
              <span>{{ block.settings.question }}</span>
              <span class="knr-faq__icon" aria-hidden="true"></span>
            </button>
            <div class="knr-faq__answer" id="knr-faq-answer-{{ section.id }}-{{ forloop.index }}" role="region">
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.view_all_text != blank -%}
      <div class="knr-faq__footer knr-animate knr-animate-delay-2">
        <a href="{{ section.settings.view_all_link | default: '#' }}" class="knr-btn knr-btn--outline knr-btn--sm">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.knr-faq__question').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.knr-faq__item');
        var list = item.closest('.knr-faq__list');
        var isOpen = item.classList.contains('active');

        /* Close all in this section */
        list.querySelectorAll('.knr-faq__item').forEach(function (el) {
          el.classList.remove('active');
          el.querySelector('.knr-faq__question').setAttribute('aria-expanded', 'false');
        });

        /* Toggle current */
        if (!isOpen) {
          item.classList.add('active');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "KNR FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions & answers"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What skin types is this suitable for?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Our serum is formulated for all skin types, including sensitive and acne-prone skin. The lightweight, non-comedogenic formula absorbs quickly without leaving a greasy residue."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR FAQ",
      "category": "Product",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What skin types is this suitable for?",
            "answer": "Our serum is formulated for all skin types, including sensitive and acne-prone skin. The lightweight, non-comedogenic formula absorbs quickly without leaving a greasy residue."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How often should I use this product?",
            "answer": "For best results, apply twice daily — morning and evening — after cleansing and toning. Consistent use over 4-6 weeks will deliver the most visible improvements."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are the ingredients ethically sourced?",
            "answer": "Yes. All our ingredients are ethically and sustainably sourced. We work directly with certified organic farms and never test on animals. Our packaging is made from recycled materials."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the shelf life after opening?",
            "answer": "Once opened, the product maintains its full efficacy for 12 months. Store in a cool, dry place away from direct sunlight for optimal preservation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
