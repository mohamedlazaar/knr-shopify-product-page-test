{%- comment -%}
  sections/feature-banner.liquid
  Full-width image with a large white statement on the right and an optional small caption on the left.


{{ section.settings.font | font_face: font_display: 'swap' }}
{%- endcomment -%}
{% style %}
  #fb-{{ section.id }} {
    --fb-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --fb-color: {{ section.settings.text_color }};
    --fb-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
    --fb-size: {{ section.settings.text_size }}px;
    --fb-size-m: {{ section.settings.text_size_mobile }}px;
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    min-height: 360px;
    overflow: hidden;
    background: #2b2823;
    color: var(--fb-color);
    font-family: var(--fb-font);
    -webkit-font-smoothing: antialiased;
  }
  #fb-{{ section.id }} * { box-sizing: border-box; }
  #fb-{{ section.id }} .fb__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #fb-{{ section.id }} .fb__overlay { position: absolute; inset: 0; background: rgba(0,0,0,var(--fb-overlay)); }
  #fb-{{ section.id }} .fb__inner { position: relative; height: 100%; display: flex; align-items: center; justify-content: flex-end; padding: 40px 3.7vw; }
  #fb-{{ section.id }} .fb__col { width: min(35%, 560px); min-width: 300px; margin-top: {{ section.settings.offset_top }}px; }
  #fb-{{ section.id }} .fb-statement { margin: 0; font-size: var(--fb-size); line-height: 1.22; font-weight: 300; letter-spacing: -0.005em; }
  #fb-{{ section.id }} .fb-statement p { margin: 0; }
  #fb-{{ section.id }} .fb-attribution { margin: 20px 0 0; font-size: 12px; opacity: .85; }
  #fb-{{ section.id }} .fb-caption::after { content: ''; display: block; width: 12px; height: 1px; margin-top: 10px; background: currentColor; }
  #fb-{{ section.id }} .fb-caption { position: absolute; left: 2.8vw; top: 48%; max-width: 240px; margin: 0; font-size: 11px; line-height: 1.4; opacity: .55; }

  #fb-{{ section.id }} picture { display: contents; }

  @media (max-width: 989px) {
    #fb-{{ section.id }} { aspect-ratio: {{ section.settings.mobile_ratio }}; min-height: 0; }
    #fb-{{ section.id }} .fb__overlay { background: linear-gradient(to top, rgba(0,0,0,.3), rgba(0,0,0,0) 60%), rgba(0,0,0,var(--fb-overlay)); }
    #fb-{{ section.id }} .fb__inner { align-items: flex-end; justify-content: flex-start; padding: 24px 20px 64px; }
    #fb-{{ section.id }} .fb__col { width: 100%; min-width: 0; margin-top: 0; }
    #fb-{{ section.id }} .fb-statement { font-size: var(--fb-size-m); line-height: 1.2; }
    #fb-{{ section.id }} .fb-attribution { margin-top: 16px; font-size: 10px; }
    #fb-{{ section.id }} .fb-caption { top: 12%; left: 20px; right: 20px; max-width: none; font-size: 10.5px; opacity: .9; }
  }
{% endstyle %}

<section id="fb-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <picture>
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 989px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
      {%- endif -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'fb__img', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw' }}
    </picture>
  {%- endif -%}
  <div class="fb__overlay"></div>

  <div class="fb__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'caption' -%}
        <p class="fb-caption" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
      {%- endif -%}
    {%- endfor -%}

    <div class="fb__col">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'statement' -%}
            <div class="fb-statement" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'attribution' -%}
            <p class="fb-attribution" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KNR Features",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional, portrait)" },
    { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "inter_n3" },
    { "type": "range", "id": "text_size", "label": "Statement size", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "offset_top", "label": "Text vertical offset", "min": -120, "max": 120, "step": 5, "unit": "px", "default": 40 },
    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "text_size_mobile", "label": "Statement size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 17 },
    {
      "type": "select", "id": "mobile_ratio", "label": "Banner ratio",
      "options": [
        { "value": "4 / 5", "label": "4:5" },
        { "value": "61 / 100", "label": "Tall (default)" },
        { "value": "9 / 16", "label": "9:16" }
      ],
      "default": "61 / 100"
    }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fusionnant l'huile de rosier muscat, le rétinol végétal et l'extrait de cactus, notre sérum pénètre en profondeur pour stimuler le renouvellement cellulaire, atténuer les rides et redonner à la peau son éclat et sa fermeté naturelles.</p>" }
      ]
    },
    {
      "type": "attribution",
      "name": "Small text",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Doctor Name" }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Notre engagement pour une beauté régénérée" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Features",
      "blocks": [
        { "type": "caption" },
        { "type": "statement" },
        { "type": "attribution" }
      ]
    }
  ]
}
{% endschema %}
