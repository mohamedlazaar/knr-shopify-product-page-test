{% comment %}
  Section 6: Product Gallery Grid
  Full-bleed grid of lifestyle/product images.
  Desktop: 4 cols, rows of square + wide images. Mobile: 2 cols.
{% endcomment %}

<section class="knr-section knr-gallery" data-section-id="{{ section.id }}">

  {%- if section.settings.heading != blank -%}
    <div class="knr-gallery__header knr-animate">
      {%- if section.settings.tag != blank -%}
        <p class="knr-label" style="margin-bottom: 8px;">{{ section.settings.tag }}</p>
      {%- endif -%}
      <h2 class="knr-heading-lg">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="knr-gallery__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'gallery_image' -%}
        <div class="knr-gallery__item{% if block.settings.wide %} knr-gallery__item--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
              loading: 'lazy',
              alt: block.settings.alt_text | default: 'Gallery image',
              sizes: '(min-width: 750px) 25vw, 50vw'
            }}
          {%- else -%}
            <div style="width:100%;height:100%;background:var(--knr-warm);display:flex;align-items:center;justify-content:center;color:var(--knr-muted);font-size:0.75rem;">
              {{ forloop.index }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "KNR Gallery Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Span two columns",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Gallery Grid",
      "category": "Product",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image", "settings": { "wide": true } },
        { "type": "gallery_image", "settings": { "wide": true } }
      ]
    }
  ]
}
{% endschema %}
