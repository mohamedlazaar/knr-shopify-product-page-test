{% comment %}
  Section 6: Product Gallery Grid
  Grid of lifestyle / product images.
  Desktop: 4 cols. Mobile: 2 cols.
  Supports wide-spanning items.
{% endcomment %}

<section class="knr-section knr-gallery" data-section-id="{{ section.id }}">
  <div class="knr-container">

    {%- if section.settings.heading != blank -%}
      <div class="knr-gallery__header knr-animate">
        {%- if section.settings.tag != blank -%}
          <p class="knr-label" style="margin-bottom: 8px;">{{ section.settings.tag }}</p>
        {%- endif -%}
        <h2 class="knr-heading-lg">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="knr-gallery__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_image' -%}
          <div class="knr-gallery__item{% if block.settings.wide %} knr-gallery__item--wide{% endif %} knr-animate knr-animate-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                alt: block.settings.alt_text | default: section.settings.heading,
                sizes: '(min-width: 750px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "KNR Gallery Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Span two columns",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR Gallery Grid",
      "category": "Product",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}
