{% comment %}
  Section 4: Skin Ritual
  Full-width centered layout with circular image and descriptive text.
{% endcomment %}

<section class="knr-section knr-ritual" data-section-id="{{ section.id }}">
  <div class="knr-container">

    <div class="knr-ritual__header knr-animate">
      {%- if section.settings.tag != blank -%}
        <p class="knr-ritual__tag">{{ section.settings.tag }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="knr-ritual__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="knr-ritual__image-wrapper knr-animate knr-animate-delay-1">
      <div class="knr-ritual__image">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 960 | image_tag:
            loading: 'lazy',
            alt: section.settings.heading,
            sizes: '(min-width: 750px) 480px, 80vw'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.description != blank -%}
      <div class="knr-ritual__desc knr-animate knr-animate-delay-2">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "KNR Skin Ritual",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / label",
      "default": "Your Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embrace your natural glow"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Circular image"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Indulge in a daily skincare ritual that combines the power of nature with advanced dermatological science. Our formulations are designed to nourish, protect, and rejuvenate your skin, delivering visible results and a luminous, healthy complexion that radiates from within.</p>"
    }
  ],
  "presets": [
    {
      "name": "KNR Skin Ritual",
      "category": "Product"
    }
  ]
}
{% endschema %}
