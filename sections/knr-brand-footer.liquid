{% comment %}
  Section 8: Brand Footer
  Large typographic brand name display.
{% endcomment %}

<section class="knr-section knr-brand-footer" data-section-id="{{ section.id }}">
  <div class="knr-container">
    <h2 class="knr-brand-footer__name knr-animate">
      {{ section.settings.brand_name | default: shop.name }}
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "KNR Brand Footer",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "maison célestine"
    }
  ],
  "presets": [
    {
      "name": "KNR Brand Footer",
      "category": "Product"
    }
  ]
}
{% endschema %}
