{{ 'knr-product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knr-animations.js' | asset_url }}" defer></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<section class="knr-product-detail-section" data-section-id="{{ section.id }}">
  <div class="knr-product-detail__wrapper">

    {%- comment -%} ══════════════════════════════════════════════
        LEFT COLUMN: FULL-WIDTH MEDIA GALLERY
    ══════════════════════════════════════════════ {%- endcomment -%}
    <div class="knr-product-detail__media-column">
      
      {%- comment -%} Main Featured Image (Takes full width of the media area) {%- endcomment -%}
      <div class="knr-product-detail__main-image-wrap">
        {%- if featured_image != blank -%}
          {{ featured_image | image_url: width: 1400 | image_tag:
            loading: 'eager',
            alt: product.title,
            id: 'knr-pdp-main-image',
            class: 'knr-product-detail__main-image'
          }}
        {%- else -%}
          <div class="knr-product-detail__image-fallback">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Secondary Images Grid (2 Columns below main image with hotspot icons) {%- endcomment -%}
      <div class="knr-product-detail__secondary-grid">
        {%- if product.images.size > 1 -%}
          {%- for image in product.images offset: 1 limit: 2 -%}
            <div class="knr-product-detail__grid-item">
              {{ image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                alt: product.title,
                class: 'knr-product-detail__grid-image'
              }}
              <button type="button" class="knr-hotspot-btn" aria-label="Agrandir ou détails">+</button>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="knr-product-detail__grid-item">
            <div class="knr-product-detail__grid-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="knr-placeholder-icon"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
            </div>
            <button type="button" class="knr-hotspot-btn" aria-label="Agrandir ou détails">+</button>
          </div>
          <div class="knr-product-detail__grid-item">
            <div class="knr-product-detail__grid-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="knr-placeholder-icon"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
            </div>
            <button type="button" class="knr-hotspot-btn" aria-label="Agrandir ou détails">+</button>
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 3 -%}
        <div class="knr-product-detail__secondary-grid">
          {%- for image in product.images offset: 3 limit: 2 -%}
            <div class="knr-product-detail__grid-item">
              {{ image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                alt: product.title,
                class: 'knr-product-detail__grid-image'
              }}
              <button type="button" class="knr-hotspot-btn" aria-label="Agrandir ou détails">+</button>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>


    {%- comment -%} ══════════════════════════════════════════════
        RIGHT COLUMN: STICKY PRODUCT DETAIL CARD WITH ALL BLOCKS
    ══════════════════════════════════════════════ {%- endcomment -%}
    <div class="knr-product-detail__info-column">
      <div class="knr-product-detail__card">

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- comment -%} 1. Breadcrumbs {%- endcomment -%}
            {%- when 'breadcrumb' -%}
              <nav class="knr-pdp__breadcrumbs" {{ block.shopify_attributes }}>
                <span>{{ block.settings.text | default: 'Soins anti-âge / Collection Cactus' }}</span>
              </nav>

            {%- comment -%} 2. Badges (UNIFIE, PROTÈGE, etc.) {%- endcomment -%}
            {%- when 'badges' -%}
              <div class="knr-pdp__badges" {{ block.shopify_attributes }}>
                {%- if block.settings.badge_1 != blank -%}
                  <span class="knr-pdp__badge">{{ block.settings.badge_1 }}</span>
                {%- endif -%}
                {%- if block.settings.badge_2 != blank -%}
                  <span class="knr-pdp__badge">{{ block.settings.badge_2 }}</span>
                {%- endif -%}
                {%- if block.settings.badge_3 != blank -%}
                  <span class="knr-pdp__badge">{{ block.settings.badge_3 }}</span>
                {%- endif -%}
              </div>

            {%- comment -%} 3. Title with Rating {%- endcomment -%}
            {%- when 'title_and_rating' -%}
              <div class="knr-pdp__title-row" {{ block.shopify_attributes }}>
                <h1 class="knr-pdp__title">
                  {{ product.title | default: block.settings.custom_title }}
                </h1>
                {%- if block.settings.show_rating -%}
                  <div class="knr-pdp__rating-inline">
                    <div class="knr-pdp__stars">★★★★★ <span class="knr-pdp__rating-score">{{ block.settings.rating_score | default: '4.7' }}</span></div>
                    <span class="knr-pdp__review-count">{{ block.settings.review_count | default: '200 avis' }}</span>
                  </div>
                {%- endif -%}
              </div>

            {%- comment -%} 4. Clean Beauty / Health Scores (Yuka, INCI Beauty) {%- endcomment -%}
            {%- when 'scores' -%}
              <div class="knr-pdp__scores" {{ block.shopify_attributes }}>
                <span class="knr-pdp__score-item">
                  <strong>Yuka</strong> {{ block.settings.yuka_score | default: '100/100' }}
                </span>
                <span class="knr-pdp__score-sep">·</span>
                <span class="knr-pdp__score-item">
                  <strong>INCI Beauty</strong> {{ block.settings.inci_score | default: '20/20' }}
                </span>
              </div>

            {%- comment -%} 5. Short Description / Excerpt {%- endcomment -%}
            {%- when 'short_description' -%}
              <div class="knr-pdp__description-excerpt" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: 'Une huile anti-âge sèche ultra fine qui travaille en synergie avec la peau pour la maintenir ferme, pleine de vitalité tout en lissant les rides.' }}
              </div>

            {%- comment -%} 6. Variant Picker (Taille / Size) {%- endcomment -%}
            {%- when 'variant_picker' -%}
              <div class="knr-pdp__variants" {{ block.shopify_attributes }}>
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <div class="knr-pdp__option-group">
                      <div class="knr-pdp__option-label">{{ option.name }}</div>
                      <div class="knr-pdp__option-pills" role="radiogroup">
                        {%- for value in option.values -%}
                          <button
                            type="button"
                            class="knr-pdp__pill{% if option.selected_value == value %} active{% endif %}"
                            data-option-index="{{ option.position }}"
                            data-value="{{ value | escape }}"
                          >
                            {{ value }}
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  {%- comment -%} Fallback demo pills if product has only default variant {%- endcomment -%}
                  <div class="knr-pdp__option-group">
                    <div class="knr-pdp__option-label">{{ block.settings.fallback_label | default: 'Taille' }}</div>
                    <div class="knr-pdp__option-pills">
                      <button type="button" class="knr-pdp__pill active">{{ block.settings.fallback_val_1 | default: '15 mL' }}</button>
                      <button type="button" class="knr-pdp__pill">{{ block.settings.fallback_val_2 | default: '150 mL' }}</button>
                    </div>
                  </div>
                {%- endunless -%}
              </div>

            {%- comment -%} 7. Price Block {%- endcomment -%}
            {%- when 'price' -%}
              <div class="knr-pdp__price-block" {{ block.shopify_attributes }}>
                <div class="knr-pdp__price-row">
                  <span class="knr-pdp__price" id="knr-pdp-price">
                    {{ current_variant.price | default: 7500 | money }}
                  </span>
                  {%- assign compare_price = current_variant.compare_at_price | default: block.settings.demo_compare_price -%}
                  {%- if compare_price > current_variant.price or block.settings.demo_compare_price != blank -%}
                    <span class="knr-pdp__price-compare" id="knr-pdp-compare-price">
                      {{ compare_price | money }}
                    </span>
                  {%- endif -%}
                </div>
                {%- if block.settings.unit_price_text != blank -%}
                  <p class="knr-pdp__unit-price">{{ block.settings.unit_price_text }}</p>
                {%- endif -%}
              </div>

            {%- comment -%} 8. Buy Buttons / Add to Cart {%- endcomment -%}
            {%- when 'buy_buttons' -%}
              <div class="knr-pdp__actions" {{ block.shopify_attributes }}>
                <product-form class="knr-pdp__form">
                  {%- form 'product', product, id: 'knr-pdp-product-form', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" id="knr-pdp-variant-id">
                    <input type="hidden" name="quantity" value="1">

                    <button
                      type="submit"
                      name="add"
                      class="knr-pdp__add-btn"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ block.settings.button_text | default: 'Ajouter au panier' }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t | default: 'Épuisé' }}
                      {%- endif -%}
                    </button>
                  {%- endform -%}
                </product-form>
              </div>

            {%- comment -%} 9. Shipping / Stock Notice {%- endcomment -%}
            {%- when 'shipping_notice' -%}
              <div class="knr-pdp__shipping-notice" {{ block.shopify_attributes }}>
                <p>{{ block.settings.text | default: 'En stock, livraison estimée Mercredi 25 février.' }}</p>
              </div>

            {%- comment -%} 10. Slider Indicator Dots / Dashes {%- endcomment -%}
            {%- when 'slider_indicators' -%}
              <div class="knr-pdp__indicators" {{ block.shopify_attributes }}>
                <span class="knr-pdp__indicator-bar active"></span>
                <span class="knr-pdp__indicator-bar"></span>
                <span class="knr-pdp__indicator-bar"></span>
              </div>

            {%- comment -%} 11. Collapsible Accordion Tab {%- endcomment -%}
            {%- when 'collapsible_tab' -%}
              <details class="knr-pdp__accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="knr-pdp__accordion-summary">
                  <span class="knr-pdp__accordion-title">{{ block.settings.heading }}</span>
                  <span class="knr-pdp__accordion-icon" aria-hidden="true">
                    <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path class="chevron-path" d="M3 5l4 4 4-4"/>
                    </svg>
                  </span>
                </summary>
                <div class="knr-pdp__accordion-content">
                  {%- if block.settings.content != blank -%}
                    {{ block.settings.content }}
                  {%- elsif block.settings.use_product_description -%}
                    {{ product.description }}
                  {%- endif -%}
                </div>
              </details>

            {%- comment -%} 12. Complementary Products / "Complétez votre rituel" {%- endcomment -%}
            {%- when 'complementary_products' -%}
              <div class="knr-pdp__cross-sell" {{ block.shopify_attributes }}>
                <div class="knr-pdp__cross-sell-header">
                  <span class="knr-pdp__cross-sell-title">{{ block.settings.heading | default: 'COMPLÉTEZ VOTRE RITUEL' }}</span>
                  <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="knr-pdp__cross-sell-arrow" aria-label="Voir la collection">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M6 12l4-4-4-4"/>
                    </svg>
                  </a>
                </div>

                <div class="knr-pdp__cross-sell-slider">
                  {%- comment -%} Product Card 1 {%- endcomment -%}
                  <div class="knr-pdp__cross-card">
                    <div class="knr-pdp__cross-media">
                      {%- if block.settings.product_1 != blank and block.settings.product_1.featured_image != blank -%}
                        {{ block.settings.product_1.featured_image | image_url: width: 300 | image_tag: loading: 'lazy' }}
                      {%- else -%}
                        <div class="knr-pdp__cross-img-fallback">
                          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 3v2h6V3"/></svg>
                        </div>
                      {%- endif -%}
                      <button type="button" class="knr-pdp__cross-add-btn" aria-label="Ajouter au panier">+</button>
                    </div>
                    <div class="knr-pdp__cross-info">
                      <p class="knr-pdp__cross-name">{{ block.settings.product_1.title | default: block.settings.product_1_title | default: 'Huile Précieuse' }}</p>
                      <p class="knr-pdp__cross-price">{{ block.settings.product_1.price | default: 6500 | money }}</p>
                    </div>
                  </div>

                  {%- comment -%} Product Card 2 {%- endcomment -%}
                  <div class="knr-pdp__cross-card">
                    <div class="knr-pdp__cross-media">
                      {%- if block.settings.product_2 != blank and block.settings.product_2.featured_image != blank -%}
                        {{ block.settings.product_2.featured_image | image_url: width: 300 | image_tag: loading: 'lazy' }}
                      {%- else -%}
                        <div class="knr-pdp__cross-img-fallback">
                          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 3v2h6V3"/></svg>
                        </div>
                      {%- endif -%}
                      <button type="button" class="knr-pdp__cross-add-btn" aria-label="Ajouter au panier">+</button>
                    </div>
                    <div class="knr-pdp__cross-info">
                      <p class="knr-pdp__cross-name">{{ block.settings.product_2.title | default: block.settings.product_2_title | default: 'Sérum Éclat' }}</p>
                      <p class="knr-pdp__cross-price">{{ block.settings.product_2.price | default: 7000 | money }}</p>
                    </div>
                  </div>

                  {%- comment -%} Product Card 3 {%- endcomment -%}
                  <div class="knr-pdp__cross-card">
                    <div class="knr-pdp__cross-media">
                      {%- if block.settings.product_3 != blank and block.settings.product_3.featured_image != blank -%}
                        {{ block.settings.product_3.featured_image | image_url: width: 300 | image_tag: loading: 'lazy' }}
                      {%- else -%}
                        <div class="knr-pdp__cross-img-fallback">
                          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 3v2h6V3"/></svg>
                        </div>
                      {%- endif -%}
                      <button type="button" class="knr-pdp__cross-add-btn" aria-label="Ajouter au panier">+</button>
                    </div>
                    <div class="knr-pdp__cross-info">
                      <p class="knr-pdp__cross-name">{{ block.settings.product_3.title | default: block.settings.product_3_title | default: 'Crème Fondante' }}</p>
                      <p class="knr-pdp__cross-price">{{ block.settings.product_3.price | default: 5800 | money }}</p>
                    </div>
                  </div>
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}

      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* Interactive Variant Pills */
    const pills = document.querySelectorAll('.knr-pdp__pill');
    pills.forEach(pill => {
      pill.addEventListener('click', function () {
        const parent = pill.closest('.knr-pdp__option-pills');
        if (parent) {
          parent.querySelectorAll('.knr-pdp__pill').forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
        }
      });
    });

    /* Accordion Auto-close others or independent smooth toggle */
    const accordions = document.querySelectorAll('.knr-pdp__accordion');
    accordions.forEach(acc => {
      acc.addEventListener('toggle', function () {
        const icon = acc.querySelector('.knr-pdp__accordion-icon svg');
        if (icon) {
          icon.style.transform = acc.open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      });
    });
  });
</script>

