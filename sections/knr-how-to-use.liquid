{%- comment -%}
  sections/how-to-use.liquid
  Heading + a row of step cards (image, number, title, description). Each step is a block.


{{ section.settings.font | font_face: font_display: 'swap' }}
{%- endcomment -%}
{% style %}
  #htu-{{ section.id }} {
    --htu-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --htu-bg: {{ section.settings.bg_color }};
    --htu-text: {{ section.settings.text_color }};
    --htu-muted: {{ section.settings.muted_color }};
    --htu-cols: {{ section.settings.columns }};
    --htu-card-m: {{ section.settings.mobile_card_width }}vw;
    background: var(--htu-bg);
    color: var(--htu-text);
    font-family: var(--htu-font);
    padding: {{ section.settings.padding_top }}px 2.8vw {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
  }
  #htu-{{ section.id }} * { box-sizing: border-box; }
  #htu-{{ section.id }} .htu__title { margin: 0 0 24px; font-size: clamp(22px, 2.2vw, 32px); font-weight: 400; line-height: 1.2; }
  #htu-{{ section.id }} .htu__grid { display: grid; grid-template-columns: repeat(var(--htu-cols), minmax(0, 1fr)); gap: 8px; }
  #htu-{{ section.id }} .htu__media { aspect-ratio: {{ section.settings.image_ratio }}; background: #e6e1d6; overflow: hidden; }
  #htu-{{ section.id }} .htu__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #htu-{{ section.id }} .htu__num { display: block; margin: 18px 0 20px; font-size: 12px; line-height: 1; }
  #htu-{{ section.id }} .htu__step-title { margin: 0 0 10px; font-size: clamp(18px, 1.7vw, 24px); font-weight: 400; line-height: 1.25; }
  #htu-{{ section.id }} .htu__text { margin: 0; max-width: 46ch; font-size: 13px; line-height: 1.5; color: var(--htu-muted); }
  #htu-{{ section.id }} .htu__text p { margin: 0; }

  #htu-{{ section.id }} .htu__more { display: none; }

  @media (max-width: 989px) {
    #htu-{{ section.id }} { padding-left: 24px; padding-right: 0; }
    #htu-{{ section.id }} .htu__title { font-size: 26px; margin-bottom: 20px; }
    #htu-{{ section.id }} .htu__grid { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-right: 24px; scroll-padding-left: 24px; }
    #htu-{{ section.id }} .htu__grid::-webkit-scrollbar { display: none; }
    #htu-{{ section.id }} .htu__card { flex: 0 0 var(--htu-card-m); scroll-snap-align: start; }
    #htu-{{ section.id }} .htu__media { aspect-ratio: {{ section.settings.mobile_image_ratio }}; }
    #htu-{{ section.id }} .htu__num { margin: 16px 0 18px; }
    #htu-{{ section.id }} .htu__step-title { font-size: 20px; }
    #htu-{{ section.id }} .htu__text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden; }
    #htu-{{ section.id }} .htu__card.is-open .htu__text { display: block; -webkit-line-clamp: unset; overflow: visible; }
    #htu-{{ section.id }} .htu__more { display: none; margin-top: 8px; padding: 0; background: none; border: 0; font: inherit; font-size: 12px; color: var(--htu-text); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
    #htu-{{ section.id }} .htu__card.is-clamped .htu__more { display: inline-block; }
  }
{% endstyle %}

<section id="htu-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="htu__title">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="htu__grid">
    {%- for block in section.blocks -%}
      <article class="htu__card" {{ block.shopify_attributes }}>
        <div class="htu__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 80vw', alt: block.settings.title }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if section.settings.show_numbers -%}
          <span class="htu__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        {%- endif -%}
        <h3 class="htu__step-title">{{ block.settings.title }}</h3>
        <div class="htu__text">{{ block.settings.text }}</div>
        <button type="button" class="htu__more" data-more="{{ section.settings.read_more_label | escape }}" data-less="{{ section.settings.read_less_label | escape }}" aria-expanded="false">{{ section.settings.read_more_label }}</button>
      </article>
    {%- endfor -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('htu-{{ section.id }}');
    if (!root) return;
    const mq = window.matchMedia('(max-width: 989px)');
    const check = () => {
      root.querySelectorAll('.htu__card').forEach((card) => {
        const text = card.querySelector('.htu__text');
        const wasOpen = card.classList.contains('is-open');
        if (wasOpen) return;
        card.classList.toggle('is-clamped', mq.matches && text.scrollHeight > text.clientHeight + 1);
      });
    };
    root.addEventListener('click', (e) => {
      const btn = e.target.closest('.htu__more');
      if (!btn) return;
      const card = btn.closest('.htu__card');
      const open = card.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open);
      btn.textContent = open ? btn.dataset.less : btn.dataset.more;
      if (!open) requestAnimationFrame(check);
    });
    window.addEventListener('resize', check);
    document.fonts && document.fonts.ready.then(check);
    check();
  })();
</script>

{% schema %}
{
  "name": "KNR How to use",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to use" },
    { "type": "checkbox", "id": "show_numbers", "label": "Show step numbers", "default": true },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "1 / 1"
    },
    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "mobile_card_width", "label": "Card width", "min": 40, "max": 90, "step": 1, "unit": "vw", "default": 46 },
    {
      "type": "select", "id": "mobile_image_ratio", "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "2 / 3", "label": "Tall portrait" }
      ],
      "default": "2 / 3"
    },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Lire plus" },
    { "type": "text", "id": "read_less_label", "label": "Read less label", "default": "Lire moins" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "muted_color", "label": "Description text", "default": "#4a4a4a" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Découvrir" },
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Description de l'étape.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "KNR How to use",
      "blocks": [
        { "type": "step", "settings": { "title": "Découvrir", "text": "<p>Concentré de pureté active. Huile végétale aux propriétés anti-oxydantes puissantes pour un éclat retrouvé.</p>" } },
        { "type": "step", "settings": { "title": "Découvrir", "text": "<p>Éclat et uniformité retrouvés. Cible les taches et les irrégularités de grain de peau.</p>" } },
        { "type": "step", "settings": { "title": "Découvrir", "text": "<p>Fermeté et nutrition intense. Répare la barrière cutanée et lisse les contours du visage.</p>" } }
      ]
    }
  ]
}
{% endschema %}
