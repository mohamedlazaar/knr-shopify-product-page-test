{% comment %}
  Section 3: How To Use
  4-column image grid showing product usage steps.
  Desktop: 4 cols. Mobile: 2 cols.
{% endcomment %}

<section class="knr-section knr-howto" data-section-id="{{ section.id }}">
  <div class="knr-container">

    <div class="knr-howto__header knr-animate">
      {%- if section.settings.tag != blank -%}
        <p class="knr-label" style="margin-bottom: 8px;">{{ section.settings.tag }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="knr-heading-lg">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="knr-howto__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="knr-howto__item knr-animate knr-animate-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                alt: block.settings.step_text,
                sizes: '(min-width: 750px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}

            {%- if block.settings.show_overlay -%}
              <div class="knr-howto__step">
                <p class="knr-howto__step-num">Step {{ forloop.index }}</p>
                <p class="knr-howto__step-text">{{ block.settings.step_text }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KNR How To Use",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / label",
      "default": "Application"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        },
        {
          "type": "text",
          "id": "step_text",
          "label": "Step description",
          "default": "Apply a few drops to cleansed skin"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show text overlay",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KNR How To Use",
      "category": "Product",
      "blocks": [
        {
          "type": "step",
          "settings": { "step_text": "Cleanse your face thoroughly" }
        },
        {
          "type": "step",
          "settings": { "step_text": "Apply 2-3 drops to fingertips" }
        },
        {
          "type": "step",
          "settings": { "step_text": "Gently massage into skin" }
        },
        {
          "type": "step",
          "settings": { "step_text": "Follow with moisturizer" }
        }
      ]
    }
  ]
}
{% endschema %}
