{%- comment -%}
  sections/footer.liquid
  Footer: link columns + about block (blocks), giant fitted wordmark, bottom bar
  (country/language selectors, copyright, social icons).
  Mobile: link columns become accordions, bottom bar is centered and stacked.
  Add it to a section group: sections/footer-group.json
{%- endcomment -%}

{{ section.settings.font | font_face: font_display: 'swap' }}
{{ section.settings.wordmark_font | font_face: font_display: 'swap' }}

{% style %}
  #ft-{{ section.id }} {
    --ft-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --ft-wm-font: {{ section.settings.wordmark_font.family }}, {{ section.settings.wordmark_font.fallback_families }};
    --ft-bg: {{ section.settings.bg_color }};
    --ft-text: {{ section.settings.text_color }};
    --ft-line: {{ section.settings.line_color }};
    --ft-wm-ls: {{ section.settings.wordmark_spacing }}px;
    background: var(--ft-bg);
    color: var(--ft-text);
    font-family: var(--ft-font);
    -webkit-font-smoothing: antialiased;
  }
  #ft-{{ section.id }} * { box-sizing: border-box; }
  #ft-{{ section.id }} a { color: inherit; text-decoration: none; }
  #ft-{{ section.id }} a:hover { opacity: .65; }
  #ft-{{ section.id }} ul { list-style: none; margin: 0; padding: 0; }
  #ft-{{ section.id }} :focus-visible { outline: 2px solid var(--ft-text); outline-offset: 3px; }

  /* ---------- Columns ---------- */
  #ft-{{ section.id }} .ft__cols { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); padding: {{ section.settings.padding_top }}px 40px 0; }
  #ft-{{ section.id }} .ft__cols.has-about { grid-template-columns: repeat({{ section.blocks.size | minus: 1 | at_least: 1 }}, minmax(0, 300fr)) minmax(0, 373fr); }
  #ft-{{ section.id }} .ft__heading { margin: 0; font-size: 12px; font-weight: 400; line-height: 1.4; }
  #ft-{{ section.id }} .ft__toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 0; background: none; border: 0; font: inherit; font-size: 12px; text-align: left; color: inherit; pointer-events: none; cursor: default; }
  #ft-{{ section.id }} .ft__toggle svg { display: none; }
  #ft-{{ section.id }} .ft__links { margin-top: 38px; }
  #ft-{{ section.id }} .ft__links li { margin-bottom: 18px; font-size: 12px; line-height: 1.5; }
  #ft-{{ section.id }} .ft__links li:last-child { margin-bottom: 0; }

  #ft-{{ section.id }} .ft__about-text { margin: 38px 0 0; max-width: 360px; font-size: 12px; line-height: 1.65; }
  #ft-{{ section.id }} .ft__about-text p { margin: 0; }
  #ft-{{ section.id }} .ft__badge { width: 50px; margin-top: 22px; }
  #ft-{{ section.id }} .ft__badge img { display: block; width: 100%; height: auto; }
  #ft-{{ section.id }} .ft__cert { margin: 22px 0 0; font-size: 12px; line-height: 1.5; }
  #ft-{{ section.id }} .ft__rule { height: 1px; margin: 18px 0 0; background: var(--ft-line); }
  #ft-{{ section.id }} .ft__cert-link { display: inline-block; margin-top: 18px; padding-bottom: 2px; border-bottom: 1px solid currentColor; font-size: 12px; }

  /* ---------- Wordmark ---------- */
  #ft-{{ section.id }} .ft__wm { padding: {{ section.settings.wordmark_top }}px 40px 0; overflow: hidden; }
  #ft-{{ section.id }} .ft__wm-text { display: inline-block; white-space: nowrap; font-family: var(--ft-wm-font); font-weight: 400; line-height: 1; letter-spacing: var(--ft-wm-ls); font-size: 13vw; }
  #ft-{{ section.id }} .ft__wm-img { display: block; width: 100%; height: auto; }

  /* ---------- Bottom bar ---------- */
  #ft-{{ section.id }} .ft__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; margin-top: 70px; padding: 34px 40px 38px; border-top: 1px solid var(--ft-line); font-size: 12px; }
  #ft-{{ section.id }} .ft__loc { display: flex; gap: 18px; align-items: center; margin: 0; }
  #ft-{{ section.id }} .ft__select { position: relative; display: inline-flex; align-items: center; }
  #ft-{{ section.id }} .ft__select select { appearance: none; -webkit-appearance: none; background: none; border: 0; padding: 4px 18px 4px 0; font: inherit; font-size: 12px; color: inherit; cursor: pointer; }
  #ft-{{ section.id }} .ft__select svg { position: absolute; right: 0; width: 10px; height: 10px; pointer-events: none; }
  #ft-{{ section.id }} .ft__copy { margin: 0; text-align: center; }
  #ft-{{ section.id }} .ft__social { display: flex; justify-content: flex-end; gap: 22px; }
  #ft-{{ section.id }} .ft__social a { display: grid; place-items: center; width: 18px; height: 18px; }
  #ft-{{ section.id }} .ft__social svg { width: 18px; height: 18px; fill: currentColor; }
  #ft-{{ section.id }} .ft__social svg.is-stroke { fill: none; stroke: currentColor; stroke-width: 2; }
  #ft-{{ section.id }} .ft__social svg.is-stroke .dot { fill: currentColor; stroke: none; }
  #ft-{{ section.id }} .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- Mobile ---------- */
  @media (max-width: 989px) {
    #ft-{{ section.id }} .ft__cols, #ft-{{ section.id }} .ft__cols.has-about { display: block; padding: {{ section.settings.padding_top_mobile }}px 24px 0; }
    #ft-{{ section.id }} .ft__col--links { border-top: 1px solid var(--ft-line); }
    #ft-{{ section.id }} .ft__toggle { padding: 16px 0; font-size: 15px; pointer-events: auto; cursor: pointer; }
    #ft-{{ section.id }} .ft__toggle svg { display: block; width: 14px; height: 14px; transition: transform .25s; }
    #ft-{{ section.id }} .ft__col--links.is-open .ft__toggle svg { transform: rotate(180deg); }
    #ft-{{ section.id }} .ft__links { display: none; margin: 0; padding: 4px 0 20px; }
    #ft-{{ section.id }} .ft__col--links.is-open .ft__links { display: block; }
    #ft-{{ section.id }} .ft__links li { font-size: 14px; margin-bottom: 14px; }
    #ft-{{ section.id }} .ft__col--about { margin-top: 48px; }
    #ft-{{ section.id }} .ft__col--about .ft__heading { font-size: 15px; }
    #ft-{{ section.id }} .ft__about-text { margin-top: 36px; max-width: none; font-size: 14px; line-height: 1.7; }
    #ft-{{ section.id }} .ft__badge { margin-top: 30px; }
    #ft-{{ section.id }} .ft__cert, #ft-{{ section.id }} .ft__cert-link { font-size: 14px; }
    #ft-{{ section.id }} .ft__cert { margin-top: 26px; }
    #ft-{{ section.id }} .ft__rule { margin-top: 26px; }
    #ft-{{ section.id }} .ft__cert-link { margin-top: 24px; }
    #ft-{{ section.id }} .ft__wm { padding: 56px 0 0; }
    #ft-{{ section.id }} .ft__bar { grid-template-columns: 1fr; justify-items: center; gap: 22px; margin-top: 44px; padding: 36px 24px 48px; font-size: 14px; }
    #ft-{{ section.id }} .ft__select select, #ft-{{ section.id }} .ft__bar { font-size: 14px; }
    #ft-{{ section.id }} .ft__copy { order: 2; }
    #ft-{{ section.id }} .ft__loc { order: 1; gap: 24px; }
    #ft-{{ section.id }} .ft__social { order: 3; justify-content: center; gap: 22px; }
    #ft-{{ section.id }} .ft__social a, #ft-{{ section.id }} .ft__social svg { width: 20px; height: 20px; }
  }
{% endstyle %}

{%- assign has_about = false -%}
{%- for block in section.blocks -%}{%- if block.type == 'about' -%}{%- assign has_about = true -%}{%- endif -%}{%- endfor -%}

<footer id="ft-{{ section.id }}">
  <div class="ft__cols{% if has_about %} has-about{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'links' -%}
          <div class="ft__col ft__col--links" data-ft-col {{ block.shopify_attributes }}>
            {%- assign panel = 'ft-panel-' | append: block.id -%}
            <h2 class="ft__heading">
              <button type="button" class="ft__toggle" aria-expanded="false" aria-controls="{{ panel }}">
                <span>{{ block.settings.heading }}</span>
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.2l4 4 4-4"/></svg>
              </button>
            </h2>
            <ul class="ft__links" id="{{ panel }}">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'about' -%}
          <div class="ft__col ft__col--about" {{ block.shopify_attributes }}>
            <h2 class="ft__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}<div class="ft__about-text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.badge != blank -%}
              <div class="ft__badge">{{ block.settings.badge | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 150, 200', alt: block.settings.cert_text | escape }}</div>
            {%- endif -%}
            {%- if block.settings.cert_text != blank -%}<p class="ft__cert">{{ block.settings.cert_text }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <div class="ft__rule"></div>
              <a class="ft__cert-link" href="{{ block.settings.link_url | default: '#' }}"{% if block.settings.link_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.wordmark != blank or section.settings.wordmark_image != blank -%}
    <div class="ft__wm" data-ft-wm aria-hidden="true">
      {%- if section.settings.wordmark_image != blank -%}
        {{ section.settings.wordmark_image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'ft__wm-img', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
      {%- else -%}
        <span class="ft__wm-text" data-ft-wm-text>{{ section.settings.wordmark }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ft__bar">
    {%- assign loc_id = 'ft-localization-' | append: section.id -%}
    {%- form 'localization', id: loc_id, class: 'ft__loc' -%}
      {%- if section.settings.show_country and localization.available_countries.size > 0 -%}
        <label class="ft__select">
          <span class="visually-hidden">{{ section.settings.country_label }}</span>
          <select name="country_code" data-ft-submit>
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.2l4 4 4-4"/></svg>
        </label>
      {%- endif -%}
      {%- if section.settings.show_language and localization.available_languages.size > 0 -%}
        <label class="ft__select">
          <span class="visually-hidden">{{ section.settings.language_label }}</span>
          <select name="language_code" data-ft-submit>
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {%- endfor -%}
          </select>
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.2l4 4 4-4"/></svg>
        </label>
      {%- endif -%}
    {%- endform -%}

    <p class="ft__copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</p>

    <div class="ft__social">
      {%- if section.settings.facebook != blank -%}
        <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M24 12.07C24 5.45 18.63.07 12 .07S0 5.45 0 12.07c0 5.99 4.39 10.95 10.13 11.85v-8.39H7.08v-3.47h3.05V9.43c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.23 2.69.23v2.95h-1.52c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.47h-2.8v8.39C19.61 23.02 24 18.06 24 12.07z"/></svg></a>
      {%- endif -%}
      {%- if section.settings.instagram != blank -%}
        <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg class="is-stroke" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4.1"/><circle class="dot" cx="17.3" cy="6.7" r="1.2"/></svg></a>
      {%- endif -%}
      {%- if section.settings.tiktok != blank -%}
        <a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg></a>
      {%- endif -%}
      {%- if section.settings.linkedin != blank -%}
        <a href="{{ section.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (() => {
    const root = document.getElementById('ft-{{ section.id }}');
    if (!root) return;

    /* Mobile accordions (on desktop the toggle is inert and lists always show) */
    root.querySelectorAll('[data-ft-col]').forEach((col) => {
      const btn = col.querySelector('.ft__toggle');
      btn.addEventListener('click', () => {
        const open = col.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open);
      });
    });

    /* Country / language selectors submit on change */
    root.querySelectorAll('[data-ft-submit]').forEach((s) => s.addEventListener('change', () => s.form.submit()));

    /* Fit the wordmark to the container width */
    const wm = root.querySelector('[data-ft-wm]');
    const text = root.querySelector('[data-ft-wm-text]');
    if (wm && text) {
      const fit = () => {
        const cs = getComputedStyle(wm);
        const avail = wm.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        text.style.fontSize = '100px';
        const w = text.getBoundingClientRect().width;
        if (w > 0) text.style.fontSize = (avail / w) * 100 + 'px';
        wm.classList.add('is-ready');
      };
      fit();
      window.addEventListener('resize', fit);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    }
  })();
</script>

{% schema %}
{
  "name": "KNR Footer",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Wordmark" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "maison célestine" },
    { "type": "image_picker", "id": "wordmark_image", "label": "Wordmark img", "info": "Use an SVG/PNG logo if you prefer; it is stretched to full width." },
    { "type": "font_picker", "id": "wordmark_font", "label": "Wordmark font", "default": "inter_n4" },
    { "type": "range", "id": "wordmark_spacing", "label": "Letter spacing", "min": -20, "max": 20, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "wordmark_top", "label": "Space top wordmark", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_country", "label": "country/currency", "default": true },
    { "type": "checkbox", "id": "show_language", "label": "Show language", "default": true },
    { "type": "text", "id": "country_label", "label": "Country label", "default": "Pays / région" },
    { "type": "text", "id": "language_label", "label": "Language label", "default": "Langue" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "Maison Célestine. Tous droits réservés." },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f9f8f4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "line_color", "label": "Dividers", "default": "#dedbd2" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Découvrir" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "about",
      "name": "About",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "À propos de Maison Célestine" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Maison Célestine est une marque de soins anti-âge haut de gamme formulée autour d'actifs rares et certifiés biologiques, guidée par une expertise médicale et un rituel simple, précis et efficace.</p>" },
        { "type": "image_picker", "id": "badge", "label": "Certification" },
        { "type": "text", "id": "cert_text", "label": "Certification", "default": "Certifié COSMOS ORGANIC par ECOCERT Greenlife" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Voir le certificat" },
        { "type": "url", "id": "link_url", "label": "Link" },
        { "type": "checkbox", "id": "link_new_tab", "label": "Open link", "default": true }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "KNR Footer",
      "blocks": [
        { "type": "links", "settings": { "heading": "Découvrir" } },
        { "type": "links", "settings": { "heading": "Service client" } },
        { "type": "links", "settings": { "heading": "Legal" } },
        { "type": "about" }
      ]
    }
  ]
}
{% endschema %}
