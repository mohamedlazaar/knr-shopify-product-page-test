{%- comment -%}
  sections/latest-news.liquid
  Heading + "see all" link, then a row of cards (image, label, title, text).
  Desktop: grid. Mobile: swipeable row with a scroll-progress line, link moves below.
{%- endcomment -%}

{{ section.settings.font | font_face: font_display: 'swap' }}

{% style %}
  #ln-{{ section.id }} {
    --ln-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    --ln-bg: {{ section.settings.bg_color }};
    --ln-text: {{ section.settings.text_color }};
    --ln-accent: {{ section.settings.accent_color }};
    --ln-cols: {{ section.settings.columns }};
    --ln-card-m: {{ section.settings.mobile_card_width }}vw;
    background: var(--ln-bg);
    color: var(--ln-text);
    font-family: var(--ln-font);
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
  }
  #ln-{{ section.id }} * { box-sizing: border-box; }
  #ln-{{ section.id }} a { color: inherit; text-decoration: none; }
  #ln-{{ section.id }} .ln__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 36px; }
  #ln-{{ section.id }} .ln__title { margin: 0; font-size: 32px; font-weight: 400; line-height: 1.2; }
  #ln-{{ section.id }} .ln__link { font-size: 12px; padding-bottom: 2px; border-bottom: 1px solid currentColor; white-space: nowrap; }
  #ln-{{ section.id }} .ln__link--mobile { display: none; }

  #ln-{{ section.id }} .ln__grid { display: grid; grid-template-columns: repeat(var(--ln-cols), minmax(0, 1fr)); gap: 8px; }
  #ln-{{ section.id }} .ln__card { display: block; min-width: 0; }
  #ln-{{ section.id }} .ln__media { aspect-ratio: {{ section.settings.image_ratio }}; background: #e8e5dc; overflow: hidden; }
  #ln-{{ section.id }} .ln__media img, #ln-{{ section.id }} .ln__media svg { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  #ln-{{ section.id }} a.ln__card:hover .ln__media img { transform: scale(1.03); }
  #ln-{{ section.id }} .ln__label { margin: 22px 0 0; font-size: 12px; line-height: 1.3; }
  #ln-{{ section.id }} .ln__dash { display: block; width: 14px; height: 1px; margin: 12px 0 22px; background: var(--ln-accent); }
  #ln-{{ section.id }} .ln__card-title { margin: 0 0 18px; font-size: 24px; font-weight: 400; line-height: 1.3; }
  #ln-{{ section.id }} .ln__text { margin: 0; font-size: 13px; line-height: 1.6; }
  #ln-{{ section.id }} .ln__text p { margin: 0; }
  #ln-{{ section.id }} .ln__bar { display: none; }

  @media (max-width: 989px) {
    #ln-{{ section.id }} { padding: {{ section.settings.padding_top_mobile }}px 24px {{ section.settings.padding_bottom_mobile }}px; }
    #ln-{{ section.id }} .ln__head { margin-bottom: 28px; }
    #ln-{{ section.id }} .ln__title { font-size: 26px; }
    #ln-{{ section.id }} .ln__link--desktop { display: none; }
    #ln-{{ section.id }} .ln__link--mobile { display: block; width: max-content; margin: 38px auto 0; font-size: 13px; }
    #ln-{{ section.id }} .ln__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-right: -24px; padding-right: 24px; scroll-padding-left: 0; }
    #ln-{{ section.id }} .ln__grid::-webkit-scrollbar { display: none; }
    #ln-{{ section.id }} .ln__card { flex: 0 0 var(--ln-card-m); scroll-snap-align: start; }
    #ln-{{ section.id }} .ln__label { margin-top: 24px; }
    #ln-{{ section.id }} .ln__card-title { font-size: 22px; }
    #ln-{{ section.id }} .ln__text { font-size: 14px; }
    #ln-{{ section.id }} .ln__bar { display: block; position: relative; width: 25vw; height: 1px; margin: 40px auto 0; background: #e6e1d6; }
    #ln-{{ section.id }} .ln__bar i { position: absolute; left: 0; top: 0; height: 100%; width: 35%; background: var(--ln-text); }
  }
{% endstyle %}

<section id="ln-{{ section.id }}">
  <div class="ln__head">
    {%- if section.settings.heading != blank -%}<h2 class="ln__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="ln__link ln__link--desktop" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="ln__grid" data-ln-grid>
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.url != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="ln__card" {% if block.settings.url != blank %}href="{{ block.settings.url }}"{% endif %} {{ block.shopify_attributes }}>
        <div class="ln__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, 65vw', alt: block.settings.title | strip_newlines }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        {%- if block.settings.label != blank -%}<p class="ln__label">{{ block.settings.label }}</p>{%- endif -%}
        <span class="ln__dash"></span>
        <h3 class="ln__card-title">{{ block.settings.title | escape | newline_to_br }}</h3>
        <div class="ln__text">{{ block.settings.text }}</div>
      </{{ tag }}>
    {%- endfor -%}
  </div>

  <div class="ln__bar" aria-hidden="true"><i></i></div>
  {%- if section.settings.link_label != blank -%}
    <a class="ln__link ln__link--mobile" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
  {%- endif -%}
</section>

<script>
  (() => {
    const root = document.getElementById('ln-{{ section.id }}');
    if (!root) return;
    const grid = root.querySelector('[data-ln-grid]');
    const thumb = root.querySelector('.ln__bar i');
    const bar = () => {
      const max = grid.scrollWidth - grid.clientWidth;
      const ratio = max > 0 ? grid.clientWidth / grid.scrollWidth : 1;
      const w = Math.max(ratio * 100, 15);
      thumb.style.width = w + '%';
      thumb.style.left = (max > 0 ? (grid.scrollLeft / max) * (100 - w) : 0) + '%';
    };
    grid.addEventListener('scroll', bar, { passive: true });
    window.addEventListener('resize', bar);
    bar();
  })();
</script>

{% schema %}
{
  "name": "Latest news",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest news" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Voir tous les articles" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "mobile_card_width", "label": "Card width (mobile)", "min": 40, "max": 90, "step": 1, "unit": "vw", "default": 65 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Small dash", "default": "#c9bfa6" },
    { "type": "font_picker", "id": "font", "label": "Font", "default": "inter_n4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "L'origine" },
        { "type": "textarea", "id": "title", "label": "Title (new line = line break)", "default": "Fondée en 2012\ndans les Alpes" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Maison Célestine est née de la passion d'une botaniste pour les plantes alpines et leurs propriétés régénérantes exceptionnelles.</p>" },
        { "type": "url", "id": "url", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Latest news",
      "blocks": [
        { "type": "article" },
        {
          "type": "article",
          "settings": {
            "label": "La formule",
            "title": "12 ingrédients\nactifs sélectionnés",
            "text": "<p>Chaque ingrédient est sourcé chez des producteurs engagés : huile de rosier muscat, rétinol végétal, extrait de cactus Cactaceae.</p>"
          }
        },
        {
          "type": "article",
          "settings": {
            "label": "L'expertise",
            "title": "15 ans de\nrecherche en lab",
            "text": "<p>Notre laboratoire indépendant teste chaque formule sur des panels de peaux diverses, garantissant efficacité et tolérance.</p>"
          }
        },
        {
          "type": "article",
          "settings": {
            "label": "L'engagement",
            "title": "97 % naturel\ncertifié",
            "text": "<p>Emballages recyclables, formules biodégradables, compensation carbone intégrale. Beauté responsable, du champ au flacon.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
